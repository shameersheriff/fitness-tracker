{
  "name": "fitness-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready full-stack fitness tracking platform.",
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "pnpm --filter @fitness-tracker/shared-types build && concurrently \"pnpm --filter @fitness-tracker/backend dev\" \"pnpm --filter @fitness-tracker/frontend dev\"",
    "dev:frontend": "pnpm --filter @fitness-tracker/shared-types build && pnpm --filter @fitness-tracker/frontend dev",
    "dev:backend": "pnpm --filter @fitness-tracker/shared-types build && pnpm --filter @fitness-tracker/backend dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "lint-staged": "lint-staged",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "db:generate": "pnpm --filter @fitness-tracker/backend db:generate",
    "db:migrate": "pnpm --filter @fitness-tracker/backend db:migrate",
    "db:seed": "pnpm --filter @fitness-tracker/backend db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.9.0"
  }
}
